{
    "name": "migears/web",
    "description": "miGears Web — 极简 REST 框架，目录即路由",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "php",
        "rest",
        "api",
        "router",
        "micro-framework",
        "lightweight"
    ],
    "require": {
        "php": "^8.1",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Web\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Web\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
