{
    "name": "migears/web",
    "description": "Minimalist REST framework with file-as-routing",
    "type": "library",
    "license": "MIT",
    "version": "2.2.0",
    "keywords": [
        "php",
        "rest",
        "api",
        "router",
        "micro-framework",
        "lightweight"
    ],
    "homepage": "https://github.com/samxxu/migears-web",
    "authors": [
        {
            "name": "Sam X. Xu",
            "email": "samxxu@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/samxxu/migears-web/issues",
        "source": "https://github.com/samxxu/migears-web"
    },
    "require": {
        "php": "^8.1",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Web\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Web\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
